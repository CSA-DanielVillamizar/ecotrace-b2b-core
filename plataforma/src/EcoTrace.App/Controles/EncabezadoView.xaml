<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoTrace.App.Controles.EncabezadoView"
             x:Name="Raiz">
    <Border BackgroundColor="{StaticResource BrandDeep}" StrokeThickness="0" Padding="24,22,24,34">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="0,0,30,30" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="6">
            <Border HorizontalOptions="Start" Padding="10,4" StrokeThickness="0"
                    BackgroundColor="{StaticResource Amber}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label Text="{Binding Etiqueta, Source={x:Reference Raiz}}" FontSize="11" FontAttributes="Bold"
                       TextColor="{StaticResource BrandDeep}" CharacterSpacing="1" />
            </Border>
            <Label Text="{Binding Titulo, Source={x:Reference Raiz}}" Style="{StaticResource Titulo}" Margin="0,4,0,0" />
            <Label Text="{Binding Subtitulo, Source={x:Reference Raiz}}" Style="{StaticResource Subtitulo}" />
            <ContentPresenter Content="{Binding Extra, Source={x:Reference Raiz}}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
