<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controles="clr-namespace:EcoTrace.App.Controles"
             x:Class="EcoTrace.App.Modulos.Cargo.CargoPage"
             Title="{Binding Titulo}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <controles:EncabezadoView Etiqueta="{Binding Escuadron}"
                                      Titulo="{Binding Descripcion}"
                                      Subtitulo="Confirma entregas sin señal: la acción queda guardada y se envía sola." />

            <VerticalStackLayout Padding="16,18,16,24" Spacing="14">
                <!-- Esqueleto: el escuadron reemplaza esta tarjeta por sus pantallas reales. -->
                <controles:GuiaDelModuloView />

                <Label Text="Acciones de este módulo" Style="{StaticResource Seccion}" Margin="0,6,0,0" />
                <controles:ListaOperacionesView Modulo="Cargo" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
