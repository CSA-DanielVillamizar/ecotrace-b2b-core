<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="White" />
    </Style>
    <Style x:Key="Subtitulo" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextoSobreOscuro}" />
    </Style>
    <Style x:Key="Seccion" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Brand}" />
    </Style>
    <Style x:Key="Apoyo" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="Etiqueta" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
        <Setter Property="Stroke" Value="{StaticResource LineaSuave}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>

    <Style x:Key="Primario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Superficie}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Superficie}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Brand}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Brand}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Muted}" />
    </Style>

</ResourceDictionary>
