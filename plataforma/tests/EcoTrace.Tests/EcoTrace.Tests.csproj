<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Este es el unico proyecto que ve los cuatro modulos: los ejercita desde afuera, por HTTP. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\EcoTrace.Identity\Api\EcoTrace.Identity.Api.csproj" />
    <ProjectReference Include="..\..\src\EcoTrace.FleetManagement\Api\EcoTrace.FleetManagement.Api.csproj" />
    <ProjectReference Include="..\..\src\EcoTrace.CargoTracking\Api\EcoTrace.CargoTracking.Api.csproj" />
    <ProjectReference Include="..\..\src\EcoTrace.Billing\Api\EcoTrace.Billing.Api.csproj" />
  </ItemGroup>

  <!--
    Pruebas de punta a punta de la app contra los servicios reales en memoria: el motor y la cola del Mobile.Core,
    y la logica del modulo Identity de la app (la misma fuente que compila la app, sin MAUI).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\EcoTrace.Mobile.Core\EcoTrace.Mobile.Core.csproj" />
    <Compile Include="..\..\src\EcoTrace.App\Modulos\Identity\Logica\*.cs" LinkBase="AppIdentityLogica" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
