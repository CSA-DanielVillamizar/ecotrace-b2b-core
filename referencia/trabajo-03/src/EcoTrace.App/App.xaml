<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controles="clr-namespace:EcoTrace.App.Controles"
             x:Class="EcoTrace.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                El banner de "Sin conexion" es un solo componente para todas las pantallas (ADR 0005): se pone aqui,
                en la plantilla de toda ContentPage, y ningun modulo tiene que acordarse de agregarlo.
            -->
            <ControlTemplate x:Key="PaginaConBanner">
                <Grid RowDefinitions="Auto,*">
                    <controles:BannerSinConexionView />
                    <ContentPresenter Grid.Row="1" />
                </Grid>
            </ControlTemplate>
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Fondo}" />
                <Setter Property="Shell.NavBarIsVisible" Value="False" />
                <Setter Property="ControlTemplate" Value="{StaticResource PaginaConBanner}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
