<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoTrace.App.Controles.BannerSinConexionView"
             IsVisible="{Binding Visible}">
    <!-- IsVisible va en la raiz: asi, sin conexion = falso, la vista no ocupa ningun espacio en la pantalla. -->
    <Border BackgroundColor="{StaticResource AdvertenciaFondo}"
            StrokeThickness="0"
            Padding="16,10,16,12"
            SemanticProperties.Description="Aviso de que no hay conexión">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="0,0,16,16" />
        </Border.StrokeShape>
        <!-- Grid y no StackLayout: asi el texto largo se parte en lineas en vez de salirse de la pantalla. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Grid.Column="0" WidthRequest="10" HeightRequest="10" VerticalOptions="Start" Margin="0,4,0,0"
                    BackgroundColor="{StaticResource Amber}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
            </Border>
            <Label Grid.Column="1"
                   Text="{Binding Texto}"
                   TextColor="{StaticResource AdvertenciaTexto}"
                   FontSize="13"
                   LineBreakMode="WordWrap" />
        </Grid>
    </Border>
</ContentView>
