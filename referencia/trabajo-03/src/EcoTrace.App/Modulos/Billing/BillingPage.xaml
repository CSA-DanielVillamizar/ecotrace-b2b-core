<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controles="clr-namespace:EcoTrace.App.Controles"
             x:Class="EcoTrace.App.Modulos.Billing.BillingPage"
             Title="Pagos">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <controles:EncabezadoView Etiqueta="BILLING &amp; ESCROW" Titulo="El estado de tus pagos"
                                      Subtitulo="Aquí ves cuándo se libera el dinero de una entrega." />

            <VerticalStackLayout Padding="16,18,16,24" Spacing="14">
                <!-- De cuándo son los datos y por qué se muestran guardados -->
                <Label Text="{Binding Actualizado}" Style="{StaticResource Apoyo}" />
                <Border Style="{StaticResource Tarjeta}" BackgroundColor="{StaticResource AdvertenciaFondo}" Stroke="Transparent"
                        IsVisible="{Binding TieneAviso}" Padding="14,10">
                    <Label Text="{Binding Aviso}" TextColor="{StaticResource AdvertenciaTexto}" FontSize="14" />
                </Border>
                <Border Style="{StaticResource Tarjeta}" BackgroundColor="{StaticResource InfoFondo}" Stroke="Transparent"
                        IsVisible="{Binding TieneMensaje}" Padding="14,10">
                    <Label Text="{Binding Mensaje}" TextColor="{StaticResource InfoTexto}" FontSize="14" />
                </Border>

                <Button Text="Actualizar" Command="{Binding Refrescar}" Style="{StaticResource Primario}" />

                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Evidencia de entrega" Style="{StaticResource Seccion}" />
                        <Label Text="Escribe qué evidencia registras y pulsa «Registrar evidencia» en el pago que corresponde." Style="{StaticResource Apoyo}" />
                        <Editor Text="{Binding Descripcion}" Placeholder="Acta de entrega firmada por la planta" HeightRequest="80" AutoSize="Disabled" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding Vacia}">
                    <Label Style="{StaticResource Apoyo}" Text="No hay pagos guardados todavía." />
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pagos}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Tarjeta}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="18" />
                                        <Border Grid.Column="1" Padding="10,4" StrokeThickness="0" BackgroundColor="{Binding EstadoFondo}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Label Text="{Binding EstadoTexto}" FontSize="12" FontAttributes="Bold" TextColor="{Binding EstadoColor}" />
                                        </Border>
                                    </Grid>
                                    <Button Text="Registrar evidencia" Command="{Binding RegistrarEvidencia}" IsVisible="{Binding PuedeRegistrarEvidencia}"
                                            Style="{StaticResource Primario}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Acciones de este módulo" Style="{StaticResource Seccion}" Margin="0,6,0,0" />
                <controles:ListaOperacionesView Modulo="Billing" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
