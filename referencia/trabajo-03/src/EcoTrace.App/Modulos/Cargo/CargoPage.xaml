<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controles="clr-namespace:EcoTrace.App.Controles"
             x:Class="EcoTrace.App.Modulos.Cargo.CargoPage"
             Title="Cargas">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <controles:EncabezadoView Etiqueta="CARGO &amp; TRACKING" Titulo="Tus cargas y entregas"
                                      Subtitulo="Confirma entregas sin señal: la acción queda guardada y se envía sola." />

            <VerticalStackLayout Padding="16,18,16,24" Spacing="14">
                <!-- De cuándo son los datos y por qué se muestran guardados -->
                <Label Text="{Binding Actualizado}" Style="{StaticResource Apoyo}" />
                <Border Style="{StaticResource Tarjeta}" BackgroundColor="{StaticResource AdvertenciaFondo}" Stroke="Transparent"
                        IsVisible="{Binding TieneAviso}" Padding="14,10">
                    <Label Text="{Binding Aviso}" TextColor="{StaticResource AdvertenciaTexto}" FontSize="14" />
                </Border>
                <Border Style="{StaticResource Tarjeta}" BackgroundColor="{StaticResource InfoFondo}" Stroke="Transparent"
                        IsVisible="{Binding TieneMensaje}" Padding="14,10">
                    <Label Text="{Binding Mensaje}" TextColor="{StaticResource InfoTexto}" FontSize="14" />
                </Border>

                <Button Text="Actualizar" Command="{Binding Refrescar}" Style="{StaticResource Primario}" />

                <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding Vacia}">
                    <Label Style="{StaticResource Apoyo}" Text="No hay cargas guardadas todavía." />
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cargas}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Tarjeta}">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Titulo}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                        <Border Grid.Column="1" Padding="10,4" StrokeThickness="0" BackgroundColor="{StaticResource InfoFondo}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Label Text="{Binding EstadoTexto}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource InfoTexto}" />
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding Ruta}" Style="{StaticResource Apoyo}" />
                                    <Label Text="{Binding Detalle}" Style="{StaticResource Apoyo}" />
                                    <Button Text="Confirmar entrega" Command="{Binding Confirmar}" IsVisible="{Binding PuedeEntregar}"
                                            Style="{StaticResource Primario}" Margin="0,6,0,0" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Acciones de este módulo" Style="{StaticResource Seccion}" Margin="0,6,0,0" />
                <controles:ListaOperacionesView Modulo="Cargo" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
