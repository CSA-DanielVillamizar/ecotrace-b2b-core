@EcoTrace.Cargo_Tracking_HostAddress = http://localhost:5004

### Obtener todas las cargas
GET {{EcoTrace.Cargo_Tracking_HostAddress}}/api/cargos
Accept: application/json

### Registrar una nueva carga
POST {{EcoTrace.Cargo_Tracking_HostAddress}}/api/cargos
Content-Type: application/json

{
  "generadorTenantId": "00000000-0000-0000-0000-000000000001",
  "transportistaTenantId": "00000000-0000-0000-0000-000000000002",
  "description": "Transporte de 15 toneladas de residuos plásticos clasificados",
  "weightKg": 15000.00,
  "originAddress": "Parque Industrial Calle 80 Km 3, Bogotá",
  "destinationAddress": "Planta de Tratamiento Ecológico, Mosquera"
}

### Obtener asignaciones de carga
GET {{EcoTrace.Cargo_Tracking_HostAddress}}/api/cargoassignments
Accept: application/json

### Iniciar tracking de una carga
POST {{EcoTrace.Cargo_Tracking_HostAddress}}/api/tracking/start
Content-Type: application/json

{
  "cargoId": "00000000-0000-0000-0000-000000000003",
  "vehicleId": "00000000-0000-0000-0000-000000000004",
  "driverId": "00000000-0000-0000-0000-000000000005",
  "initialLatitude": 4.7110,
  "initialLongitude": -74.0721,
  "initialCheckpoint": "Salida punto origen Bogotá"
}
