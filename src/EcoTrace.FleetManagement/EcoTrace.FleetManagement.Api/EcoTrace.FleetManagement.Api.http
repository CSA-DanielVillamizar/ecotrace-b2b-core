@EcoTrace.FleetManagement_HostAddress = http://localhost:5003

### Obtener todos los conductores
GET {{EcoTrace.FleetManagement_HostAddress}}/api/drivers
Accept: application/json

### Registrar un nuevo conductor
POST {{EcoTrace.FleetManagement_HostAddress}}/api/drivers
Content-Type: application/json

{
  "tenantId": "00000000-0000-0000-0000-000000000001",
  "userId": "00000000-0000-0000-0000-000000000002",
  "fullName": "Carlos Rodríguez",
  "licenseNumber": "C2-987654321",
  "phone": "+57 300 1234567"
}

### Obtener todos los vehículos
GET {{EcoTrace.FleetManagement_HostAddress}}/api/vehicles
Accept: application/json

### Registrar un nuevo vehículo
POST {{EcoTrace.FleetManagement_HostAddress}}/api/vehicles
Content-Type: application/json

{
  "tenantId": "00000000-0000-0000-0000-000000000001",
  "plateNumber": "WNZ789",
  "brand": "Kenworth",
  "model": "T800",
  "capacityKg": 32000.00
}
